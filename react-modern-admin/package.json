{
  "name": "react-modern",
  "version": "0.1.0",
  "scripts": {
    "reset": "npx rimraf node_modules ./**/node_modules",
    "dev": "modern dev",
    "build": "modern build",
    "start": "modern start",
    "serve": "modern serve",
    "new": "modern new",
    "prepare": "lefthook install",
    "lint": "run-p lint:*",
    "lint:type": "tsc --noEmit",
    "lint:fix": "biome check --write",
    "lint:style": "stylelint \"src/**/*.{css,less}\" --fix",
    "upgrade": "modern upgrade",
    "commit": "git status && git add -A && git-cz && git push"
  },
  "dependencies": {
    "@douyinfe/semi-icons": "^2.102.0",
    "@douyinfe/semi-ui": "^2.102.0",
    "@modern-js/runtime": "3.8.2",
    "ahooks": "^3.9.6",
    "axios": "^1.8.4",
    "i18next": "^25.7.4",
    "i18next-browser-languagedetector": "^8.2.0",
    "lodash-es": "4.17.21",
    "motion": "^12.27.0",
    "npm-run-all": "^4.1.5",
    "ogl": "^1.0.11",
    "qs": "6.14.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-i18next": "^16.5.3",
    "three": "^0.182.0",
    "unplugin-auto-import": "^20.3.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@douyinfe/semi-rspack-plugin": "^2.102.0",
    "@modern-js/app-tools": "3.8.2",
    "@modern-js/plugin-polyfill": "3.8.2",
    "@modern-js/tsconfig": "3.8.2",
    "@rsbuild/plugin-svgr": "^2.0.0",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "@stylistic/stylelint-plugin": "^5.0.1",
    "@types/jest": "~29.2.4",
    "@types/lodash-es": "4.17.12",
    "@types/node": "^20",
    "@types/qs": "6.14.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.182.0",
    "clsx": "^2.1.1",
    "commitizen": "^4.3.0",
    "cz-git": "^1.12.0",
    "lefthook": "^2.0.4",
    "postcss": "^8.5.3",
    "postcss-less": "^6.0.0",
    "postcss-loader": "^8.1.1",
    "react-scan": "^0.4.3",
    "rimraf": "^6.0.1",
    "rsbuild-plugin-glsl": "^1.2.0",
    "stylelint": "^17.1.1",
    "stylelint-config-recess-order": "^7.6.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "stylelint-less": "^4.0.0",
    "stylelint-order": "^7.0.1",
    "tailwind-merge": "^3.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "engines": {
    "node": "22.18.0"
  },
  "pnpm": {
    "overrides": {
      "@tiptap/core": "3.30.5",
      "@tiptap/pm": "3.30.5"
    }
  }
}
